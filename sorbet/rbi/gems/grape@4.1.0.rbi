  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:600
  def version; end

  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:600
  def version_options; end

  class << self
    # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:600
    def [](*_arg0); end

    # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:600
