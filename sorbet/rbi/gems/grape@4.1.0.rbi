    # pkg:gem/grape#lib/grape/dsl/rescue_options.rb:19
    def inspect; end

    # pkg:gem/grape#lib/grape/dsl/rescue_options.rb:19
    def members; end

    # pkg:gem/grape#lib/grape/dsl/rescue_options.rb:19
    def new(*_arg0); end
  end
end

