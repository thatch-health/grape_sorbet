end

# pkg:gem/grape#lib/grape/util/lazy/value_enumerable.rb:6
class Grape::Util::Lazy::ValueEnumerable < ::Grape::Util::Lazy::Value
  # pkg:gem/grape#lib/grape/util/lazy/value_enumerable.rb:7
