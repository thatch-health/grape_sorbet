end

# pkg:gem/grape#lib/grape/util/lazy/value_hash.rb:6
class Grape::Util::Lazy::ValueHash < ::Grape::Util::Lazy::ValueEnumerable
  # pkg:gem/grape#lib/grape/util/lazy/value_hash.rb:7
