  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:277
  def params_documentation; end

  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:35
  def parent; end

  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:414
  def parsers; end

