  def internal_grape_exceptions_rescue_handler; end

  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:642
  def lint!; end

  # pkg:gem/grape#lib/grape/util/inheritable_setting.rb:646
  def lint?; end

